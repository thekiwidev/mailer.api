# Server Configuration
PORT=3000

# SMTP Server Configuration
# For Render and cloud providers: Use Port 587 (TLS/STARTTLS) - more reliable
# For local/on-premise: Can also try Port 465 (SSL)
CUSTOM_EMAIL_HOST=imeldayayala.com.ng
CUSTOM_EMAIL_PORT=587
CUSTOM_EMAIL_SECURE=false

# SMTP Authentication Credentials (for connecting to the mail server)
CUSTOM_EMAIL_SMTP_USER=developer@imeldayayala.com.ng
CUSTOM_EMAIL_SMTP_PASS=your_smtp_password_here

# Email Sender Configuration (what the form filler sees as the sender)
CUSTOM_EMAIL_FROM=noreply@imeldayayala.com.ng
CUSTOM_EMAIL_FROM_PASS=your_from_email_password_here

# Email Recipient (where application emails are sent to)
RECIPIENT_EMAIL=developer@imeldayayala.com.ng
